# Phone numbers, as "display form|E.164". Never committed with real values:
# the repository is public. Set these as GitHub Actions *variables*.
NEXT_PUBLIC_PHONE_PT="+351 000 000 000|+351000000000"
NEXT_PUBLIC_PHONE_BR="+55 00 00000-0000|+550000000000"

# Bare digits for the wa.me deep link.
NEXT_PUBLIC_WHATSAPP="550000000000"

# Web3Forms access key. Public by design — it reaches the client bundle either
# way — but kept out of the source tree.
NEXT_PUBLIC_WEB3FORMS_KEY=""

# Canonical origin, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL="https://jeferson0306.github.io/portfolio-v2"
